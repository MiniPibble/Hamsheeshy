-- LOGIC & ANTI-TAMPER PERSISTENCE
local StartTime = tick()
local LoadingDuration = 90 -- 1 Minute 30 Seconds
local IsFinished = false
local Connection

Connection = RunService.RenderStepped:Connect(function()
    -- BYPASS: Ensure UI stays in protected storage
    if ScreenGui.Parent ~= SecureParent then
        ScreenGui.Parent = SecureParent
    end

    local Elapsed = tick() - StartTime
    local Progress = math.clamp(Elapsed / LoadingDuration, 0, 1)

    -- Update Bar and Text
    Fill.Size = UDim2.new(Progress, 0, 1, 0)
    PercentLabel.Text = math.floor(Progress * 100) .. "%"
    TimerLabel.Text = string.format("%02d:%02d", math.floor(Elapsed/60), math.floor(Elapsed%60))

    -- Status Update Logic
    if Progress < 0.25 then
        Status.Text = "Fetching encrypted patches..."
    elseif Progress < 0.50 then
        Status.Text = "Bypassing anti-cheat signatures..."
    elseif Progress < 0.75 then
        Status.Text = "Injecting secure modules..."
    elseif Progress < 1 then
        Status.Text = "Finalizing environment..."
    end

    -- Completion Logic
    if Progress >= 1 and not IsFinished then
        IsFinished = true
        Status.Text = "Bypass Successful!"
        
        -- SMOOTH DISAPPEAR
        local Fade = TweenService:Create(Main, TweenInfo.new(1.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {GroupTransparency = 1})
        Fade:Play()
        
        Fade.Completed:Connect(function()
            Connection:Disconnect()
            ScreenGui:Destroy()
        end)
    end
end)
